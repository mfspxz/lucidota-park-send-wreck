{
  "schema_version": "1",
  "name": "psw-workbench",
  "codon": "wb",
  "version": "0.1.0",
  "description": "composition canvas: validate a flow DAG before anything executes (organelle)",
  "contracts": [
    {
      "op": "compose",
      "description": "validate a flow against the organelle catalog; refuse unknown organelles, undeclared contracts, cycles",
      "input_schema": {
        "type": "object",
        "required": [
          "flow",
          "catalog"
        ],
        "properties": {
          "flow": {
            "type": "object"
          },
          "catalog": {
            "type": "object"
          }
        }
      }
    }
  ],
  "authority": {
    "mutation_class": "read_only",
    "declared_valence": "proven",
    "required_capability": null,
    "granted_capabilities": []
  },
  "transports": [
    "native",
    "unix_socket",
    "mcp",
    "rest"
  ],
  "receipt_policy": {
    "content_addressed": true,
    "algorithm": "sha256",
    "chain": true
  }
}
